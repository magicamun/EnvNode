# EnvNode-owned: see repository LICENSE.
# Debian receiver: daily timer, 14 archives per nonempty file; no copytruncate.
/var/log/envnode/*.jsonl /var/log/envnode/*/*.jsonl /var/log/envnode/*/by-source/*.jsonl /var/log/envnode/unrecognized.log /var/log/envnode/unrouted.log {
    daily
    rotate 14
    missingok
    notifempty
    compress
    delaycompress
    create 0640 root adm
    su root adm
    sharedscripts
    postrotate
        /usr/bin/systemctl kill --kill-whom=main --signal=HUP rsyslog.service
    endscript
}
